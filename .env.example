# Copie para .env.local (site) e cadastre como secrets no GitHub Actions (ingestão).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SOMENTE no GitHub Actions / scripts de ingestão. Nunca no front.

# Ingestão
CONTATO_EMAIL=                        # vai no User-Agent das chamadas às APIs públicas
CPF_HASH_SALT=                        # string aleatória longa; gere com: openssl rand -hex 32
PORTAL_TRANSPARENCIA_API_KEY=         # chave gratuita da CGU (fase 3)

# Revalidação on-demand das páginas
REVALIDATE_SECRET=                    # openssl rand -hex 32
SITE_URL=https://lupamunicipal.vercel.app
